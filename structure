Расчеты для c = 7.5
python
def approach_constant_hyperbolic(c, a, k=1):
    return c * a / (a + k)

c = 7.5
a_values = [10, 100, 500, 1000, 3000, 5000, 10000]

print("Гиперболическое приближение к c = 7.5")
print("=" * 55)

# Разные коэффициенты скорости
k_values = [1, 10, 50, 100, 500]

for k in k_values:
    print(f"\nk = {k}:")
    print("-" * 35)
    for a in a_values:
        result = approach_constant_hyperbolic(c, a, k)
        percentage = (result / c) * 100
        print(f"a = {a:5d}: {result:8.6f} ({percentage:6.2f}% от c)")
