# ==============================================================
Итоговая оценка рейтинга фильма на основе kp, imdb, lf в зависимости от числа проголосовавших (lf)
def calculate_final_rating(kp, imdb, lf, lf_votes, w_kp=1, w_imdb=0.5, wd_lf=2, k=50):
    w_lf = wd_lf * lf_votes / (lf_votes + k)

    numerator = kp * w_kp + imdb * w_imdb + lf * w_lf
    denominator = w_kp + w_imdb + w_lf

    return numerator / denominator

kp - рейтинг КиноПоиска (1-10)
imdb - рейтинг IMDB (1-10)
lf - рейтинг LordFilm (1-10)
lf_votes - количество голосов на LordFilm (лайки + дизлайки)

Весовые коэффициенты:
w_kp = 1 - базовый вес КиноПоиска
w_imdb = 0.5 - вес IMDB (в 2 раза меньше KP)
wd_lf = 2 - максимальный вес LordFilm

k = 50 - константа сглаживания

Пример 1: Популярный фильм (много голосов)
kp = 8.4, imdb = 7.8, lf = 8.4, lf_votes = 8525
w_lf = 2 * 8525 / (8525 + 50) ≈ 1.988  # почти максимальный вес

final = (8.4*1 + 7.8*0.5 + 8.4*1.988) / (1 + 0.5 + 1.988) ≈ 8.3
Пример 2: Новый фильм (мало голосов)
kp = 7.2, imdb = 6.9, lf = 7.5, lf_votes = 15
w_lf = 2 * 15 / (15 + 50) ≈ 0.46  # небольшой вес

final = (7.2*1 + 6.9*0.5 + 7.5*0.46) / (1 + 0.5 + 0.46) ≈ 7.0
Пример 3: Нишевый фильм (среднее количество голосов)
kp = 6.8, imdb = 6.5, lf = 8.1, lf_votes = 200
w_lf = 2 * 200 / (200 + 50) = 1.6

final = (6.8*1 + 6.5*0.5 + 8.1*1.6) / (1 + 0.5 + 1.6) ≈ 7.4

