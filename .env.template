# LordFilm Parser - Environment Variables Template
# ============================================================================
# Copy to .env file and fill in your values
# These variables override settings in config.ini
# ============================================================================

# ============================================================================
# Database Configuration (PostgreSQL)
# ============================================================================

# PostgreSQL connection
#export DATABASE_HOST=localhost
#export DATABASE_PORT=5432
#export DATABASE_NAME=movie_db
#export DATABASE_USER=movie_user
#export DATABASE_PASSWORD=password

# ============================================================================
# Telegram Bot Configuration
# ============================================================================

# Telegram Bot API token from @BotFather
#export TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Optional: Admin user IDs (comma-separated)
#export TELEGRAM_ADMIN_IDS=123456789,987654321

# ============================================================================
# Parser Core Configuration
# ============================================================================

# Target website URL
#export PARSER_DEFAULT_URL=https://wk.lordfilm17.ru

# Default category for parsing
#export PARSER_DEFAULT_CATEGORY=filmy

# Year range for parsing
#export PARSER_YEAR_START=2016
#export PARSER_YEAR_END=2025

# ============================================================================
# Selenium Configuration (for headless browser)
# ============================================================================

# Selenium WebDriver URL (for remote Selenium)
#export SELENIUM_URL=http://localhost:4444/wd/hub

# Timeout settings
#export SELENIUM_TIMEOUT=30
#export REQUEST_TIMEOUT=15

# Concurrent parsing tasks
#export MAX_CONCURRENT_PARSE_TASKS=5

# ============================================================================
# Performance & Rate Limiting
# ============================================================================

# Batch sizes
#export LINKS_BATCH_SIZE=100
#export FILMS_BATCH_SIZE=10

# Delays between operations (seconds)
#export BATCH_DELAY=1.0
#export FILM_DELAY=2.0
#export REQUEST_DELAY=1.0

# Retry configuration
#export MAX_RETRIES=2
#export RETRY_DELAY=5

# ============================================================================
# URL Generation & Pagination
# ============================================================================

# Number of pages to parse
#export DAILY_PAGES=50
#export WEEKLY_PAGES=50
#export PARSE_PAGES=50

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
#export LOG_LEVEL=INFO

# Log format (for systemd/journalctl use simple format)
#export LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s